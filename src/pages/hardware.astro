---

<Layout
	title="Hardware — Pentos"
	description="Explore the mechanical architecture, electronics, and bill of materials for the Pentos five-axis hardware retrofit."
>
	<main>
		<PageIntro
			id="hardware"
			title="Hardware"
			description="The mechanical and electronic systems that add tilt and rotation to a standard Ender 3."
		/>

		<section class="border-b border-border bg-background" aria-label="Pentos hardware render">
			<div class="mx-auto max-w-7xl px-6 pt-0 pb-12 lg:px-8 lg:pb-8 xl:px-12">
                <video
                    class="block aspect-video w-full transform-gpu"
                    autoplay
                    loop
                    muted
                    playsinline
                    preload="metadata"
                    aria-label="Animated render of the Pentos five-axis hardware"
                >
                    <source src={spinningRender} type="video/webm" />
                    Your browser does not support embedded video.
                </video>
			</div>
		</section>

		<section class="border-b border-border bg-background" aria-labelledby="mechanical-title">
			<div class="mx-auto max-w-5xl px-6 py-20 lg:px-8 lg:py-28 xl:px-12">
				<SectionHeading
					id="mechanical-title"
					description="See how the printer's existing linear motion works with the two added build-platform axes."
				>
					Mechanical <span class="text-primary">Architecture</span>
				</SectionHeading>

				<div class="mt-10 grid gap-5 lg:grid-cols-3">
					<article
						class="flex h-full flex-col overflow-hidden rounded-2xl border border-border bg-card shadow-sm lg:col-span-2 lg:row-span-2"
					>
						<div class="relative grid aspect-square flex-1 place-items-center overflow-hidden bg-muted">
							<Image
								class="h-full w-full object-contain"
								src={pentosRender}
								alt="Complete Pentos five-axis Ender 3 retrofit"
								width={900}
								height={695}
							/>
							<Image
								class="pointer-events-none absolute inset-0 h-full w-full object-contain"
								src={arrowOverlay}
								alt=""
								width={900}
								height={695}
								aria-hidden="true"
							/>
						</div>
						<div class="p-6">
							<h3 class="font-heading text-2xl font-semibold tracking-tight">
								Complete 5-Axis Assembly
							</h3>
							<p class="mt-3 leading-7 text-muted-foreground">
								Pentos combines the Ender 3's X, Y, and Z movement with dedicated tilt and spin
								axes at the build platform.
							</p>
						</div>
					</article>

					{
						assemblies.map((assembly) => (
							<FeatureCard {...assembly} imageFit="contain" imageAspect="video" />
						))
					}
				</div>
			</div>
		</section>

		<section class="border-b border-border bg-muted/40" aria-labelledby="electronics-title">
			<div class="mx-auto max-w-7xl px-6 py-20 lg:px-8 lg:py-28 xl:px-12">
				<SectionHeading
					id="electronics-title"
					description="Follow how a sliced toolpath becomes synchronized movement across the printer and both added platform axes."
				>
					Electronics and <span class="text-primary">Control</span>
				</SectionHeading>

				<div class="mt-10">
					<ElectronicsControlDiagram />
				</div>
			</div>
		</section>

		<section class="border-b border-border bg-background" aria-labelledby="bom-title">
			<div class="mx-auto max-w-7xl px-6 py-20 lg:px-8 lg:py-28 xl:px-12">
				<SectionHeading
					id="bom-title"
					description="Current working parts list. Configurable electronics and custom-part prices vary by component choice."
				>
					Bill of <span class="text-primary">Materials</span>
				</SectionHeading>
				<p class="mt-5 text-center font-heading text-lg font-semibold text-foreground">
					Priced components:
					<span class="ml-2 text-4xl font-bold tracking-tight text-primary underline">
						$141.43
					</span>
				</p>

				<div class="mt-10 overflow-x-auto rounded-2xl border border-border bg-card shadow-sm">
					<table class="w-full border-collapse text-left text-sm">
						<thead class="bg-muted">
							<tr>
								<th class="px-5 py-4 font-semibold text-foreground" scope="col">Component</th>
								<th class="px-5 py-4 font-semibold text-foreground" scope="col">Quantity</th>
								<th class="px-5 py-4 font-semibold text-foreground" scope="col">Unit Price</th>
								<th class="px-5 py-4 font-semibold text-foreground" scope="col">Total</th>
								<th class="px-5 py-4 font-semibold text-foreground" scope="col">Source</th>
							</tr>
						</thead>
						<tbody>
							{
								bomRows.map((row) => (
									<tr class="border-t border-border">
										<th class="px-5 py-4 font-medium text-foreground" scope="row">
											{row.component}
										</th>
										<td class="px-5 py-4 text-muted-foreground">{row.quantity}</td>
										<td class="px-5 py-4 text-muted-foreground">{row.unitPrice}</td>
										<td class="px-5 py-4 font-medium text-foreground">{row.total}</td>
										<td class="px-5 py-4">
											{row.href ? (
												<a
													class="font-medium text-secondary no-underline hover:underline"
													href={row.href}
													target="_blank"
													rel="noreferrer"
												>
													View
												</a>
											) : (
												<span class="text-muted-foreground">—</span>
											)}
										</td>
									</tr>
								))
							}
						</tbody>
					</table>
				</div>
			</div>
		</section>

		<section class="bg-background">
			<div class="mx-auto max-w-7xl px-6 pt-12 lg:px-8 lg:pt-16 xl:px-12">
				<CallToAction>
					<h2 class="font-heading text-3xl font-semibold tracking-tight sm:text-4xl">
						Download the hardware files
					</h2>
					<p class="mt-3 text-lg leading-7 text-muted-foreground">
						Get the CAD models, printable parts, and bill of materials for the Pentos retrofit.
					</p>
					<Fragment slot="actions">
						<Button class="w-full sm:w-auto" variant="primary" size="lg" href="#">
							Download CAD
						</Button>
						<Button class="w-full sm:w-auto" variant="outline" size="lg" href="#">
							View All Files
						</Button>
					</Fragment>
				</CallToAction>
			</div>
		</section>
	</main>
</Layout>
