---
import { Image } from 'astro:assets';
import pentosRender from '../assets/pentos_render.png';
import arrowOverlay from '../assets/hardware/arrow_overlay.png';
import spinAxis from '../assets/hardware/spin_axis.gif';
import spinningRender from '../assets/hardware/spinning_render.webm';
import tiltAxis from '../assets/hardware/tilt_axis.gif';
import ElectronicsControlDiagram from '../components/ElectronicsControlDiagram.astro';
import DataTable from '../components/ui/DataTable.astro';
import Button from '../components/ui/Button.astro';
import CallToAction from '../components/ui/CallToAction.astro';
import FeatureCard from '../components/ui/FeatureCard.astro';
import PageIntro from '../components/ui/PageIntro.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Layout from '../layouts/Layout.astro';

const assemblies = [
	{
		title: 'A Axis (Tilt Axis)',
		description:
			'A GT2 belt drive with a 2:1 reduction tilts the build platform.',
		image: tiltAxis,
		alt: 'Animation showing the Pentos build platform tilting',
	},
	{
		title: 'B Axis (Spin Axis)',
		description:
			'A 1:1 GT2 belt drive rotates the surface. Heater wiring limits repeated turns in one direction.',
		image: spinAxis,
		alt: 'Animation showing the Pentos build platform spinning',
	},
];

const retrofitRows = [
	['Pulleys and belts', 'Two 20T motor pulleys, 20T and 40T REX pulleys, two 184 mm GT2 belts', 'Gates / goBILDA', '$32.34'],
	['8 mm REX shafts', 'Two 32 mm shafts and one 52 mm shaft, with E-clips', 'goBILDA', '$12.17'],
	['Sonic hubs', 'Two 1309 Series hubs with 8 mm REX bore', 'goBILDA', '$15.98'],
	['Bearings', 'Four flanged REX bearings and one 12 × 21 × 5 mm thrust bearing', 'goBILDA', '$16.97'],
	['Stepper motors', 'Two 42STH48-1684MAC NEMA 17 motors', 'LDO', '$38.98'],
	['Mounting hardware', 'Four silicone spacers, four 15 mm M3 standoffs, eight M4 heat-set inserts', 'Amazon / REV / CNC Kitchen', '$7.59'],
	['Screws', 'Eight M4 × 12 mm, one M3 × 8 mm, four M3 × 35 mm, one M4 × 16 mm', 'Bolts and Nuts', '$2.56'],
	['Heated platform', 'Heatbed Tile and 90 × 90 mm Garolite G10 plate', 'Prusa Research / Amazon', '$25.64'],
	['Printed structure', '125 g of PLA including fabrication supports', 'PLA filament', '$2.25'],
	['Heater connector', 'One 4-pin Clickmate 0151350402', 'Molex', '$3.69'],
	['JST connectors', 'Four XHP-3 housings, one XHP-2 housing, 14 contacts', 'JST', '$2.13'],
	['Wire', '21.5 ft of 22 AWG stranded wire', 'Pololu', '$4.71'],
];

const suppliedRows = [
	['Base printer', 'Ender 3 or compatible clone budget allocation', '$150.00'],
	['Controller', 'BIGTREETECH SKR 1.4 Turbo with five TMC2208 drivers', '$65.79'],
	['Host', 'Raspberry Pi 4 Model B, 4 GB board', '$100.00'],
	['Rotary homing', 'Two 12 × 3 mm magnets and two A3144 Hall-effect sensors', '$1.97'],
];

---

<Layout
	title="Hardware — Pentos"
	description="Explore the mechanical architecture, electronics, and bill of materials for the Pentos five-axis hardware retrofit."
>
	<main>
		<PageIntro
			id="hardware"

			description="The mechanical and electronic systems that add tilt and rotation to the tested Creality Ender 3 V2."
		>
			<Fragment slot="title">Turning a Desktop Printer Into a <span class="text-secondary">Five-Axis Machine</span></Fragment>
		</PageIntro>

		<section class="border-b border-border bg-background" aria-label="Pentos hardware render">
			<div class="mx-auto max-w-7xl px-6 pt-0 pb-12">
                <video
                    class="block aspect-video w-full transform-gpu"
                    autoplay
                    loop
                    muted
                    playsinline
                    preload="metadata"
                    aria-label="Animated render of the Pentos five-axis hardware"
                >
                    <source src={spinningRender} type="video/webm" />
                    Your browser does not support embedded video.
                </video>
			</div>
		</section>

		<section class="border-b border-border bg-muted/40" aria-labelledby="mechanical-title">
			<div class="mx-auto max-w-5xl px-6 py-20">
				<SectionHeading
					id="mechanical-title"
					description="See how the printer's existing linear motion works with the two added build-platform axes."
				>
					Mechanical <span class="text-primary">Architecture</span>
				</SectionHeading>

				<div class="mt-10 grid gap-5 lg:grid-cols-3">
					<article
						class="flex h-full flex-col overflow-hidden rounded-2xl border border-border bg-card shadow-sm lg:col-span-2 lg:row-span-2"
					>
						<div class="relative grid aspect-square flex-1 place-items-center overflow-hidden bg-muted">
							<Image
								class="h-full w-full object-contain"
								src={pentosRender}
								alt="Complete Pentos five-axis Ender 3 retrofit"
								width={900}
								height={695}
							/>
							<Image
								class="pointer-events-none absolute inset-0 h-full w-full object-contain"
								src={arrowOverlay}
								alt=""
								width={900}
								height={695}
								aria-hidden="true"
							/>
						</div>
						<div class="p-6">
							<h3 class="font-heading text-2xl font-semibold tracking-tight">
								Complete 5-Axis Assembly
							</h3>
							<p class="mt-3 leading-7 text-muted-foreground">
								The retrofit mounts to the existing Y-axis carriage and retains the original Cartesian motion system. Two LDO NEMA 17 motors drive the rotary axes. The 90 × 90 mm, 24 V Prusa Heatbed Tile has an integrated thermistor and uses a Garolite G10 print surface.
							</p>
						</div>
					</article>

					{
						assemblies.map((assembly) => (
							<FeatureCard {...assembly} />
						))
					}
				</div>
			</div>
		</section>

		<section class="border-b border-border bg-background" aria-labelledby="electronics-title">
			<div class="mx-auto max-w-7xl px-6 py-20">
				<SectionHeading
					id="electronics-title"
					description="Follow how a sliced toolpath becomes synchronized movement across the printer and both added platform axes."
				>
					Electronics and <span class="text-primary">Control</span>
				</SectionHeading>

				<div class="mt-10">
					<ElectronicsControlDiagram />
					<div class="mx-auto mt-8 grid max-w-5xl gap-5 text-base leading-7 text-muted-foreground md:grid-cols-2">
						<p>The Ender 3 V2 board drives XYZ and the extruder. A BIGTREETECH SKR 1.4 Turbo controls A, B, and the heated tile. A Raspberry Pi 4 coordinates both boards through Klipper.</p>
						<p>A3144 Hall-effect sensors detect embedded magnets for repeatable rotary homing. Klipper offsets establish axis zero from each trigger. Builders adapting the retrofit to another printer should check mounting geometry, clearances, and electronics.</p>
					</div>
				</div>
			</div>
		</section>

		<section class="border-b border-border bg-muted/40" aria-labelledby="bom-title">
			<div class="mx-auto max-w-7xl px-6 py-20">
				<SectionHeading
					id="bom-title"
					description="Estimated 2026 reproduction costs for the quantities used. Pack prices are prorated, and shipping and tax are excluded."
				>
					Bill of <span class="text-primary">Materials</span>
				</SectionHeading>
				<p class="mt-5 text-center text-lg text-muted-foreground">
					<strong class="text-foreground">$482.77 total</strong> · $332.77 excluding the base printer · $165.01 in retrofit parts
				</p>
				<div class="mt-8 space-y-5">
					<DataTable caption="Retrofit parts" columns={['Component', 'Quantity and specification', 'Supplier', 'Cost']} rows={retrofitRows} />
					<DataTable caption="Estimated replacement cost of supplied hardware" columns={['Component', 'Specification', 'Cost']} rows={suppliedRows} />
				</div>
			</div>
		</section>

		<section class="bg-background">
			<div class="mx-auto max-w-7xl px-6 pt-12">
				<CallToAction>
					<h2 class="font-heading text-3xl font-semibold tracking-tight sm:text-4xl">
						Download the hardware files
					</h2>
					<p class="mt-3 text-lg leading-7 text-muted-foreground">
						Get the CAD models, printable parts, and bill of materials for the Pentos retrofit.
					</p>
					<Fragment slot="actions">
						<Button class="w-full sm:w-auto" variant="primary" size="lg" href="https://github.com/Evanston09/pentos/blob/main/hardware/Pentos.step">
							View STEP model
						</Button>
						<Button class="w-full sm:w-auto" variant="outline" size="lg" href="https://github.com/Evanston09/pentos/tree/main/hardware">
							Browse hardware files
						</Button>
					</Fragment>
				</CallToAction>
			</div>
		</section>
	</main>
</Layout>
