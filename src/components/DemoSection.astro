---
import demoVideo from '../assets/demo.mp4';
---

<section
	id="results"
	class="bg-background"
	aria-labelledby="demo-title"
>
	<div class="mx-auto max-w-7xl px-6 py-12 lg:px-8 lg:py-16 xl:px-12">
		<h2
			id="demo-title"
			class="text-center font-heading text-4xl leading-tight font-semibold tracking-tight sm:text-5xl"
		>
			See Pentos <span class="text-primary">In Motion</span>
		</h2>

		<div class="mt-10 overflow-hidden rounded-2xl">
			<video
				class="block aspect-video w-full transform-gpu bg-foreground"
				autoplay
				loop
				muted
				playsinline
				preload="metadata"
				aria-label="Pentos build platform tilting and rotating during a print"
			>
				<source src={demoVideo} type="video/mp4" />
				Your browser does not support embedded video.
			</video>
		</div>
	</div>
</section>
