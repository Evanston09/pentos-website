---
import { Image } from 'astro:assets';
import prototype from '../assets/research/prototype.jpg';
import Button from './ui/Button.astro';
---

<section class="mx-auto grid max-w-7xl items-center gap-10 px-6 py-14 lg:grid-cols-2 lg:py-20" aria-labelledby="hero-title">
	<div>
		<h1 id="hero-title" class="font-heading text-5xl leading-tight font-semibold tracking-tight sm:text-6xl">
			Five-axis printing on an <span class="text-secondary">Ender 3</span>
		</h1>
		<p class="mt-6 max-w-xl text-lg leading-8 text-muted-foreground">
			Pentos adds a tilting, rotating heated build plate to a desktop 3D printer. Use cutting planes to print from multiple orientations or curved guides to print continuous nonplanar layers, all in one browser-based slicer.
		</p>
		<div class="mt-8 flex flex-wrap gap-3">
			<Button variant="secondary" size="lg" href="/research">Explore the results</Button>
			<Button variant="outline" size="lg" href="/hardware">See the hardware</Button>
		</div>
	</div>
	<figure class="overflow-hidden rounded-2xl border border-border bg-card">
		<Image src={prototype} alt="The physical Pentos retrofit mounted on an Ender 3 V2" width={1000} loading="eager" class="w-full" />
	</figure>
</section>
