---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import Button from './ui/Button.astro';

const navItems = [
	{ label: 'Home', href: '/' },
	{ label: 'Hardware', href: '/hardware' },
	{ label: 'Software', href: '/software' },
	{ label: 'Research', href: '/research' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="border-b border-border bg-background">
	<div class="mx-auto flex max-w-7xl flex-wrap items-center px-6">
		<a class="flex h-16 items-center lg:h-20 lg:w-40" href="/" aria-label="Pentos home">
			<Image
				class="h-8 w-auto"
				src={logo}
				alt="Pentos"
				loading="eager"
			/>
		</a>

		<nav class="order-last w-full lg:order-none lg:w-auto lg:flex-1" aria-label="Primary navigation">
			<ul class="flex flex-wrap items-center gap-x-4 lg:justify-center">
				{
					navItems.map((item) => {
						const isActive = item.href === currentPath;

						return (
						<li>
							<a
								class:list={[
									'inline-flex h-10 items-center lg:h-20 text-sm font-medium no-underline transition-colors',
									isActive
										? 'text-primary'
										: 'text-muted-foreground hover:text-foreground',
								]}
								href={item.href}
								aria-current={isActive ? "page" : undefined}
							>
								{item.label}
							</a>
						</li>
						);
					})
				}
			</ul>
		</nav>

		<div class="ml-auto flex justify-end lg:w-40">
			<Button variant="primary" href="https://github.com/Evanston09/pentos-slicer">
				Get the Slicer
			</Button>
		</div>
	</div>
</header>
