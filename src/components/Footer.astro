---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';

interface Link {
	label: string;
	href: string;
	external?: boolean;
}

const projectLinks: Link[] = [
	{ label: 'Research', href: '/research' },
	{ label: 'Demo', href: '/#results' },
	{ label: 'How It Works', href: '/#how-it-works' },
];

const resourceLinks: Link[] = [
	{ label: 'Hardware', href: '/hardware' },
	{ label: 'Software', href: '/software' },
	{
		label: 'Slicer source',
		href: 'https://github.com/Evanston09/pentos-slicer',
		external: true,
	},
	{ label: 'GitHub', href: 'https://github.com/Evanston09/pentos', external: true },
];
---

<footer class="border-t border-border bg-background text-foreground">
	<div class="mx-auto max-w-7xl px-6 py-12 lg:py-16">
		<div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
			<div class="max-w-sm sm:col-span-2">
				<a class="inline-flex items-center" href="/" aria-label="Pentos home">
					<Image class="h-8 w-auto" src={logo} alt="Pentos" />
				</a>
				<p class="mt-5 max-w-md leading-7 text-muted-foreground">
					An open-source hardware retrofit and software workflow making five-axis 3D printing
					more accessible.
				</p>
			</div>

			{[
				{ title: 'Project', links: projectLinks },
				{ title: 'Resources', links: resourceLinks },
			].map(({ title, links }) => (
				<nav aria-labelledby={`footer-${title.toLowerCase()}-title`}>
					<h2 id={`footer-${title.toLowerCase()}-title`} class="font-heading text-sm font-semibold tracking-wide text-foreground">
						{title}
					</h2>
					<ul class="mt-4 space-y-3">
						{links.map(({ label, href, external }) => (
							<li>
								<a
									class="text-sm text-muted-foreground no-underline transition-colors hover:text-foreground hover:underline"
									href={href}
									target={external ? '_blank' : undefined}
									rel={external ? 'noopener noreferrer' : undefined}
								>{label}</a>
							</li>
						))}
					</ul>
				</nav>
			))}
		</div>

		<div
			class="mt-12 border-t border-border pt-6 text-sm text-muted-foreground"
		>
			<p>&copy; {new Date().getFullYear()} Pentos. All rights reserved.</p>
		</div>
	</div>
</footer>
