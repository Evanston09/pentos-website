---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { Icon } from 'astro-icon/components';

interface Props {
	title: string;
	description: string;
	image: ImageMetadata;
	alt: string;
	href?: string;
}

const { title, description, image, alt, href } = Astro.props;
---

<article class="flex h-full flex-col overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
	<div class="relative aspect-video overflow-hidden">
		<Image class="absolute inset-0 h-full w-full object-contain" src={image} alt={alt} width={700} />
	</div>

	<div class="flex flex-1 flex-col p-5">

		<h3 class="font-heading text-lg font-semibold tracking-tight">
			{title}
		</h3>
		<p class="mt-2 text-sm leading-6 text-muted-foreground">
			{description}
		</p>
		{
			href && (
				<a
					class="mt-auto inline-flex items-center gap-1.5 pt-5 text-sm font-medium text-secondary no-underline hover:underline"
					href={href}
				>
					Learn more
					<Icon class="size-4" name="hugeicons:arrow-right-02" aria-hidden="true" />
				</a>
			)
		}
	</div>
</article>
